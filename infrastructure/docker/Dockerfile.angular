# ============================================================
# Dependencies stage
# Installs exact versions from package-lock.json
# ============================================================
FROM node:22-alpine AS dependencies

WORKDIR /app

COPY frontend/commerce-dashboard/package.json ./
COPY frontend/commerce-dashboard/package-lock.json ./

RUN npm ci


# ============================================================
# Development stage
# Runs Angular's development server with live reload
# ============================================================
FROM dependencies AS development

WORKDIR /app

COPY frontend/commerce-dashboard/. .

EXPOSE 4200

CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000"]


# ============================================================
# Build stage
# Generates optimized Angular static assets
# ============================================================
FROM dependencies AS build

WORKDIR /app

COPY frontend/commerce-dashboard/. .

RUN npm run build -- --configuration production


# ============================================================
# Production stage
# Serves the Angular application through Nginx
# ============================================================
FROM nginx:alpine AS production

COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build \
    /app/dist/commerce-dashboard/browser \
    /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]