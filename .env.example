JWT__KEY=

# Shopify
SHOPIFY__CLIENTID=
SHOPIFY__CLIENTSECRET=
SHOPIFY__SCOPES=

# AI
AI__PROVIDER=
AI__APIKEY=

# Frontend
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080